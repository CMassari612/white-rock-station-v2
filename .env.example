# Backend Environment Variables
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Stripe Tax Rate ID for the Armstrong County 5% lodging tax (txr_...).
# Must match the active Stripe mode (test rate for test keys, live rate for live keys).
STRIPE_TAX_RATE_ID=txr_your_tax_rate_id_here
PORT=5000

# Frontend Environment Variables (Vite requires VITE_ prefix)
VITE_API_URL=http://localhost:5000
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
# Google Maps Embed API key (used for the location map on the About & Contact page)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_embed_api_key_here

# Email (SMTP) — authenticate as the real mailbox, but send from a free alias.
# SMTP_USER is the account that logs in (your paid Google Workspace mailbox).
# SMTP_PASS is that account's app password (not the normal login password).
# EMAIL_FROM is the address shown to recipients — set this to your free alias
#   so you don't pay for a second mailbox. The alias must be added under
#   "Send mail as" for the SMTP_USER account, or Gmail will reject the send.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=admin@whiterockstation.com
SMTP_PASS=your_gmail_app_password_here
EMAIL_FROM=White Rock Station Bookings <bookings@whiterockstation.com>
# Where cabin cleaning notifications are sent (defaults to admin@whiterockstation.com)
# ADMIN_CLEANING_EMAIL=admin@whiterockstation.com

# Admin Password (simple auth for Phase 1)
ADMIN_PASSWORD=admin123

# Development/testing only: bypass admin auth completely
# DISABLE_ADMIN_AUTH=true
